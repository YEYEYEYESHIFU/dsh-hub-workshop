    "lifecycle": {
      "activation": "immediate",
      "dispose": "unknown"
    },
    "permissions": ["filesystem:read"],
    "evidence": {
      "install": null,
      "failureIsolation": null,
      "hotReload": null,
      "remove": null
    }
  }
}
