{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hub.omdsh.dev/market-layers.schema.json",
  "title": "OMDSH Workshop non-plugin market layers",
  "type": "object",
  "required": ["schema", "generatedAt", "policy", "totals", "projects"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "omdsh-market-layers/v2" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "policy": {
      "type": "object",
      "required": ["pluginCatalog", "installationRegistry", "infrastructure", "distribution", "excluded"],
      "additionalProperties": false,
      "properties": {
        "pluginCatalog": { "const": "catalog.json remains the leaf-plugin authority" },
        "installationRegistry": { "const": "registry-v1.json remains the only installation authority" },
        "infrastructure": { "type": "string", "minLength": 1 },
        "distribution": { "type": "string", "minLength": 1 },
        "excluded": { "type": "string", "minLength": 1 }
      }
    },
    "totals": {
      "type": "object",
      "required": ["projects", "infrastructure", "distribution"],
      "additionalProperties": false,
      "properties": {
        "projects": { "type": "integer", "minimum": 0 },
        "infrastructure": { "type": "integer", "minimum": 0 },
        "distribution": { "type": "integer", "minimum": 0 }
      }
    },
    "projects": {
      "type": "array",
      "items": { "$ref": "#/$defs/project" }
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "required": ["id", "layer", "name", "description", "kind", "category", "tags", "author", "source", "updatedAt", "version", "license", "featured", "discovery", "review", "verification", "registry"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$" },
        "layer": { "enum": ["infrastructure", "distribution"] },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["manager", "toolkit", "application", "collection", "integration"] },
        "category": { "enum": ["infrastructure", "platform"] },
        "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "author": {
          "type": "object",
          "required": ["name", "url"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "pattern": "^https://github\\.com/" }
          }
        },
        "source": {
          "type": "object",
          "required": ["repository", "ref", "path"],
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string", "pattern": "^https://github\\.com/" },
            "ref": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[A-Za-z0-9._/-]+)$" },
            "path": { "type": ["string", "null"] }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" },
        "version": { "type": ["string", "null"] },
        "license": { "type": "string", "minLength": 1 },
        "featured": { "type": "boolean" },
        "discovery": {
          "type": "object",
          "required": ["stars", "commitUpdatedAt"],
          "additionalProperties": false,
          "properties": {
            "stars": { "type": "integer", "minimum": 0 },
            "createdAt": { "type": ["string", "null"], "format": "date-time" },
            "commitUpdatedAt": { "type": "string", "format": "date-time" },
            "metadataUpdatedAt": { "type": "string", "format": "date-time" },
            "archived": { "type": "boolean" }
          }
        },
        "review": {
          "type": "object",
          "required": ["state", "reason"],
          "additionalProperties": false,
          "properties": {
            "state": { "enum": ["curated", "pending-review"] },
            "reason": { "enum": ["ecosystem-infrastructure", "community-distribution", "dsh-integration"] }
          }
        },
        "verification": {
          "type": "object",
          "required": ["state", "evidence"],
          "additionalProperties": false,
          "properties": {
            "state": { "enum": ["source-pinned", "static-reviewed", "unverified"] },
            "evidence": { "type": "string", "minLength": 1 }
          }
        },
        "registry": {
          "type": "object",
          "required": ["state", "reason"],
          "additionalProperties": false,
          "properties": {
            "state": { "const": "ineligible" },
            "reason": { "const": "market-layer-not-plugin-install" }
          }
        }
      }
    }
  }
}
