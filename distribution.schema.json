{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hub.0.org.cn/distribution.schema.json",
  "title": "OMDSH Community Distribution Source",
  "type": "object",
  "required": [
    "schema",
    "id",
    "version",
    "channel",
    "title",
    "summary",
    "translations",
    "maintainer",
    "compatibility",
    "agentPreset",
    "useCases",
    "items",
    "application"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "omdsh-distribution/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "channel": { "enum": ["preview", "stable"] },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 12 },
    "translations": {
      "type": "object",
      "required": ["en"],
      "additionalProperties": false,
      "properties": { "en": { "$ref": "#/$defs/localizedText" } }
    },
    "maintainer": {
      "type": "object",
      "required": ["name", "url"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "compatibility": {
      "type": "object",
      "required": ["harness", "declared"],
      "additionalProperties": false,
      "properties": {
        "harness": { "const": "official-profile/v1" },
        "declared": { "type": "string", "minLength": 12 }
      }
    },
    "agentPreset": {
      "type": "object",
      "required": ["mode", "id"],
      "additionalProperties": false,
      "properties": {
        "mode": { "const": "builtin" },
        "id": { "enum": ["code", "cordis", "minimal", "standard"] }
      }
    },
    "useCases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/taskIntent" }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "oneOf": [{ "$ref": "#/$defs/registryItem" }, { "$ref": "#/$defs/fixedSourceItem" }] }
    },
    "application": {
      "type": "object",
      "required": ["candidate", "confirmation", "recovery", "externalSideEffects"],
      "additionalProperties": false,
      "properties": {
        "candidate": { "const": "required" },
        "confirmation": { "const": "required" },
        "recovery": { "const": "managed-profile-generation" },
        "externalSideEffects": { "const": "not-covered" }
      }
    }
  },
  "$defs": {
    "registryItem": {
      "type": "object",
      "required": ["projectId", "releaseId", "enabled"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "registry" },
        "projectId": { "type": "string", "minLength": 1 },
        "releaseId": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" }
      }
    },
    "fixedSourceItem": {
      "type": "object",
      "required": ["type", "id", "packageName", "version", "enabled", "license", "source", "install"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "source" },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "packageName": { "type": "string", "pattern": "^(?:@[a-z0-9._-]+/)?[a-z0-9._-]+$" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$" },
        "enabled": { "type": "boolean" },
        "license": {
          "type": "object",
          "required": ["expression", "source"],
          "additionalProperties": false,
          "properties": {
            "expression": { "type": "string", "minLength": 1, "maxLength": 256 },
            "source": { "enum": ["package-manifest", "author-declared"] }
          }
        },
        "source": {
          "type": "object",
          "required": ["repository", "ref"],
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$" },
            "ref": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        },
        "install": {
          "type": "object",
          "required": ["mode", "spec"],
          "additionalProperties": false,
          "properties": {
            "mode": { "const": "profile-bundle" },
            "spec": { "type": "string", "pattern": "^github:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9a-f]{40}$" }
          }
        }
      }
    },
    "localizedText": {
      "type": "object",
      "required": ["title", "summary"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 12 }
      }
    },
    "taskIntent": {
      "type": "object",
      "required": ["id", "title", "translations"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "translations": {
          "type": "object",
          "required": ["en"],
          "additionalProperties": false,
          "properties": { "en": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
