{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hub.omdsh.dev/registry-trust-roots.schema.json",
  "title": "OMDSH Registry Trust Roots",
  "type": "object",
  "required": ["$schema", "schema", "keys"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "omdsh-registry-trust-roots/v1" },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["keyId", "algorithm", "publicKeySpkiBase64", "status", "validFrom"],
        "additionalProperties": false,
        "properties": {
          "keyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "algorithm": { "const": "Ed25519" },
          "publicKeySpkiBase64": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" },
          "status": { "enum": ["active", "retired", "revoked"] },
          "validFrom": { "type": "string", "format": "date-time" },
          "validUntil": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
