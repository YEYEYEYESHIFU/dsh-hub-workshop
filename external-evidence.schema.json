{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hub.omdsh.dev/external-evidence.schema.json",
  "type": "object",
  "required": ["$schema", "schema", "generatedAt", "policy", "providers", "summary", "observations", "rejected"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "./external-evidence.schema.json" },
    "schema": { "const": "omdsh-supplemental-evidence/v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "policy": {
      "type": "object",
      "required": ["purpose", "grantsVerification", "grantsAdmission", "grantsInstallAuthority", "exactReleaseRequiredForDeepVerification"],
      "additionalProperties": false,
      "properties": {
        "purpose": { "const": "candidate-prioritization-and-independent-corroboration" },
        "grantsVerification": { "const": false },
        "grantsAdmission": { "const": false },
        "grantsInstallAuthority": { "const": false },
        "exactReleaseRequiredForDeepVerification": { "const": true }
      }
    },
    "providers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/provider" } },
    "summary": { "$ref": "#/$defs/summary" },
    "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } },
    "rejected": { "type": "array", "items": { "$ref": "#/$defs/rejected" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "repository": {
      "type": "object",
      "required": ["id", "fullName", "url"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "null" },
        "fullName": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "url": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" }
      }
    },
    "provider": {
      "type": "object",
      "required": ["id", "repository", "sourceCommit", "artifact", "method", "reportedCounts", "authority"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "repository": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifact": {
          "type": "object",
          "required": ["path", "digest"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "digest": { "$ref": "#/$defs/digest" }
          }
        },
        "method": {
          "type": "object",
          "required": ["kind", "isolation", "runtimeSelection", "reproducibility"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "isolation": { "type": "string", "minLength": 1 },
            "runtimeSelection": { "const": "latest-at-observation" },
            "reproducibility": { "const": "external-artifact-only" }
          }
        },
        "reportedCounts": { "type": ["object", "null"] },
        "authority": { "const": "supplemental-only" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["rawEntries", "observations", "rejected", "duplicateRepositoryRows", "statuses"],
      "additionalProperties": false,
      "properties": {
        "rawEntries": { "type": "integer", "minimum": 0 },
        "observations": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "duplicateRepositoryRows": { "type": "integer", "minimum": 0 },
        "statuses": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reported-pass": { "type": "integer", "minimum": 0 },
            "reported-fail": { "type": "integer", "minimum": 0 },
            "inconclusive": { "type": "integer", "minimum": 0 },
            "not-run": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "required": ["id", "provider", "repository", "scope", "observedAt", "runtime", "probe", "authority", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "provider": { "type": "string", "minLength": 1 },
        "repository": { "$ref": "#/$defs/repository" },
        "scope": {
          "type": "object",
          "required": ["type", "path", "packageName"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "repository" },
            "path": { "type": "null" },
            "packageName": { "type": "null" }
          }
        },
        "observedAt": { "type": "string", "format": "date-time" },
        "runtime": {
          "type": "object",
          "required": ["package", "version", "channel"],
          "additionalProperties": false,
          "properties": {
            "package": { "const": "@deepseek-ai/dsh" },
            "version": { "type": "null" },
            "channel": { "const": "latest-at-observation" }
          }
        },
        "probe": {
          "type": "object",
          "required": ["status", "reason"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["reported-pass", "reported-fail", "inconclusive", "not-run"] },
            "rawVerdict": { "type": "string", "maxLength": 200 },
            "rawVerdicts": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "maxLength": 200 } },
            "reason": { "type": ["string", "null"], "maxLength": 1000 }
          },
          "oneOf": [
            { "required": ["rawVerdict"], "not": { "required": ["rawVerdicts"] } },
            { "required": ["rawVerdicts"], "not": { "required": ["rawVerdict"] } }
          ]
        },
        "authority": { "const": "supplemental-only" },
        "source": {
          "type": "object",
          "required": ["providerCommit", "artifactPath", "artifactDigest", "entryIndexes"],
          "additionalProperties": false,
          "properties": {
            "providerCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "artifactPath": { "type": "string", "minLength": 1 },
            "artifactDigest": { "$ref": "#/$defs/digest" },
            "entryIndexes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } }
          }
        }
      }
    },
    "rejected": {
      "type": "object",
      "required": ["entryIndex", "name", "reason"],
      "additionalProperties": false,
      "properties": {
        "entryIndex": { "type": "integer", "minimum": 0 },
        "name": { "type": "string", "maxLength": 200 },
        "reason": { "enum": ["unresolved-repository-url", "restricted-owner"] }
      }
    }
  }
}
